<%- include('../partials/header') %>
	<div class="app-shell"><%- include('../partials/sidebar') %>
			<main class="main">
				<header class="topbar"><button class="theme-toggle" type="button" aria-label="Switch to dark mode"
						aria-pressed="false"><i class="fa-regular fa-moon"></i><span>Dark mode</span></button><span
						class="avatar">
						<% if(user.profilePhoto){ %><img src="<%= user.profilePhoto %>" alt="">
							<% }else{ %>
								<%= user.name[0] %>
									<% } %>
					</span><span class="admin-label"><b>
							<%= user.name %>
						</b><small>Administrator</small></span></header>
				<div class="content"><%- include('../partials/alerts') %>
						<div class="page-heading">
							<div>
								<h1>Teams</h1>
								<p>One team is allowed per campus</p>
							</div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#add" <%= availableCampuses.length ? '' : 'disabled' %>><i
									class="fa-solid fa-plus me-2"></i>Add team</button>
						</div>
						<div class="panel">
							<div class="table-responsive">
								<table class="table align-middle">
									<thead>
										<tr>
											<th>Team</th>
											<th>Campus</th>
											<th>Username</th>
											<th>Status</th>
											<th>Action</th>
										</tr>
									</thead>
									<tbody>
										<% teams.forEach(t=>{ %><tr>
												<td><b>
														<%= t.team_name %>
													</b></td>
												<td>
													<%= t.campus %>
												</td>
												<td>
													<%= t.username %>
												</td>
												<td><span class="badge-status <%= t.is_active?'live':'draft' %>">
														<%= t.is_active?'Active':'Inactive' %>
													</span></td>
												<td><button type="button" class="icon-btn edit-team me-1"
														data-id="<%= t.id %>" data-name="<%= t.team_name %>"
														data-username="<%= t.username %>"
														data-campus-id="<%= t.campus_id %>" data-bs-toggle="modal"
														data-bs-target="#edit"><i class="fa-solid fa-pen"></i></button>
													<form class="d-inline" method="post"
														action="/admin/teams/<%= t.id %>/status"><input type="hidden"
															name="_csrf" value="<%= csrfToken %>"><button
															class="btn btn-sm btn-outline-primary">
															<%= t.is_active?'Deactivate':'Activate' %>
														</button></form>
													<form class="d-inline" method="post"
														action="/admin/teams/<%= t.id %>/delete"
														onsubmit="return confirm('Delete this team and its saved quiz history permanently?')">
														<input type="hidden" name="_csrf"
															value="<%= csrfToken %>"><button class="icon-btn danger"
															title="Delete team"><i
																class="fa-regular fa-trash-can"></i></button></form>
												</td>
											</tr>
											<% }); if(!teams.length){ %>
												<tr>
													<td class="empty" colspan="5">No teams registered. Add a team to get
														started.</td>
												</tr>
												<% } %>
									</tbody>
								</table>
							</div>
						</div>
				</div>
			</main>
	</div>
	<div class="modal fade" id="add">
		<div class="modal-dialog">
			<form class="modal-content" method="post" action="/admin/teams">
				<div class="modal-header">
					<h5>Register team</h5><button class="btn-close" data-bs-dismiss="modal"></button>
				</div>
				<div class="modal-body"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label
						class="form-label">Team name</label><input class="form-control mb-3" name="team_name"
						required><label class="form-label">Campus</label><select class="form-select mb-3"
						name="campus_id" required>
						<% availableCampuses.forEach(c=>{ %><option value="<%= c.id %>">
								<%= c.name %>
							</option>
							<% }) %>
					</select><label class="form-label">Login username</label><input class="form-control mb-3"
									name="username" required><label class="form-label">Team password (default:
										cityteam123)</label><input class="form-control" name="password" type="text" minlength="8"
										value="<%= defaultTeamPassword %>"></div>
				<div class="modal-footer"><button class="btn btn-primary">Register team</button></div>
			</form>
		</div>
	</div>
	<div class="modal fade" id="edit">
		<div class="modal-dialog">
			<form class="modal-content" id="editTeamForm" method="post">
				<div class="modal-header">
					<h5>Edit team</h5><button class="btn-close" data-bs-dismiss="modal"></button>
				</div>
				<div class="modal-body"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label
						class="form-label">Team name</label><input class="form-control mb-3" id="editTeamName"
						name="team_name" required><label class="form-label">Campus</label><select
						class="form-select mb-3" id="editTeamCampus" name="campus_id" required>
						<% campuses.forEach(c=>{ %><option value="<%= c.id %>">
								<%= c.name %>
							</option>
							<% }) %>
					</select><label class="form-label">Login username</label><input class="form-control mb-3"
						id="editTeamUsername" name="username" required><label class="form-label">New password (leave
						blank to keep current)</label><input class="form-control" name="password" type="password"
						minlength="8"></div>
				<div class="modal-footer"><button class="btn btn-primary">Save changes</button></div>
			</form>
		</div>
	</div>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
	<script src="/js/app.js"></script>
	</body>

	</html>
