<%- include('../partials/header') %>
	<div class="app-shell"><%- include('../partials/sidebar') %>
			<main class="main">
				<header class="topbar"><button class="theme-toggle" type="button" aria-label="Switch to dark mode"
						aria-pressed="false"><i class="fa-regular fa-moon"></i><span>Dark mode</span></button><span
						class="avatar">
						<% if(user.profilePhoto){ %><img src="<%= user.profilePhoto %>" alt="">
							<% }else{ %>
								<%= user.name[0] %>
									<% } %>
					</span><span class="admin-label"><b>
							<%= user.name %>
						</b><small>Administrator</small></span></header>
				<div class="content"><%- include('../partials/alerts') %>
						<div class="page-heading">
							<div>
								<h1>Campuses</h1>
								<p>Manage the four City College campuses</p>
							</div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#add"><i
									class="fa-solid fa-plus me-2"></i>Add campus</button>
						</div>
						<div class="panel">
							<div class="table-responsive">
								<table class="table align-middle">
									<thead>
										<tr>
											<th>#</th>
											<th>Campus name</th>
											<th>Location</th>
											<th>Status</th>
											<th>Teams</th>
											<th>Actions</th>
										</tr>
									</thead>
									<tbody>
										<% campuses.forEach((c,i)=>{ %><tr>
												<td>
													<%= i+1 %>
												</td>
												<td><b><i class="fa-solid fa-building-columns campus-icon me-2"></i>
														<%= c.name %>
													</b></td>
												<td>
													<%= c.location %>
												</td>
												<td><span class="badge-status <%= c.is_active?'live':'draft' %>">
														<%= c.is_active?'Active':'Inactive' %>
													</span></td>
												<td>
													<%= c.teams %>
												</td>
												<td><button class="icon-btn edit-campus" data-id="<%= c.id %>"
														data-name="<%= c.name %>" data-location="<%= c.location %>"
														data-bs-toggle="modal" data-bs-target="#edit"><i
															class="fa-solid fa-pen"></i></button>
								<form class="d-inline" method="post"
									action="/admin/campuses/<%= c.id %>/status">
									<input type="hidden" name="_csrf" value="<%= csrfToken %>">
									<button class="btn btn-sm btn-outline-primary"><%= c.is_active ? 'Deactivate' : 'Activate' %></button>
								</form>
								<% if (!c.teams) { %>
								<form class="d-inline" method="post"
									action="/admin/campuses/<%= c.id %>/delete"
									onsubmit="return confirm('Permanently delete this campus?')"><input
										type="hidden" name="_csrf" value="<%= csrfToken %>"><button
										class="icon-btn danger" title="Delete campus"><i
											class="fa-regular fa-trash-can"></i></button></form>
								<% } %>
												</td>
											</tr>
											<% }); %>
									</tbody>
								</table>
							</div>
						</div>
				</div>
			</main>
	</div>
	<div class="modal fade" id="add">
		<div class="modal-dialog">
			<form class="modal-content" method="post" action="/admin/campuses">
				<div class="modal-header">
					<h5>Add campus</h5><button class="btn-close" data-bs-dismiss="modal"></button>
				</div>
				<div class="modal-body"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label
						class="form-label">Campus name</label><input class="form-control mb-3" name="name"
						required><label class="form-label">Location</label><input class="form-control" name="location"
						required></div>
				<div class="modal-footer"><button class="btn btn-primary">Save campus</button></div>
			</form>
		</div>
	</div>
	<div class="modal fade" id="edit">
		<div class="modal-dialog">
			<form class="modal-content" id="editForm" method="post">
				<div class="modal-header">
					<h5>Edit campus</h5><button class="btn-close" data-bs-dismiss="modal"></button>
				</div>
				<div class="modal-body"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label
						class="form-label">Campus name</label><input class="form-control mb-3" id="editName" name="name"
						required><label class="form-label">Location</label><input class="form-control" id="editLocation"
						name="location" required></div>
				<div class="modal-footer"><button class="btn btn-primary">Update campus</button></div>
			</form>
		</div>
	</div>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
	<script src="/js/app.js"></script>
	</body>

	</html>
