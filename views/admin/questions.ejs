<%- include('../partials/header') %>
	<div class="app-shell"><%- include('../partials/sidebar') %>
			<main class="main">
				<header class="topbar"><button class="theme-toggle" type="button" aria-label="Switch to dark mode"
						aria-pressed="false"><i class="fa-regular fa-moon"></i><span>Dark mode</span></button><span
						class="avatar">
						<% if(user.profilePhoto){ %><img src="<%= user.profilePhoto %>" alt="">
							<% }else{ %>
								<%= user.name[0] %>
									<% } %>
					</span><span class="admin-label"><b>
							<%= user.name %>
						</b><small>Administrator</small></span></header>
				<div class="content"><%- include('../partials/alerts') %>
						<div class="page-heading">
							<div>
								<h1>Questions</h1>
								<p>Add multiple-choice questions to a competition</p>
							</div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#add"><i
									class="fa-solid fa-plus me-2"></i>Add question</button>
						</div>
						<div class="panel">
							<div class="table-responsive">
								<table class="table align-middle">
									<thead>
										<tr>
											<th>Question</th>
											<th>Competition</th>
											<th>Options</th>
											<th>Action</th>
										</tr>
									</thead>
									<tbody>
										<% questions.forEach(q=>{ %><tr>
												<td>
													<%= q.question_text %>
												</td>
												<td>
													<%= q.competition %>
												</td>
												<td>
													<%= q.option_count %> options
												</td>
												<td><a class="icon-btn d-inline-grid place-items-center me-1"
														href="/admin/questions/<%= q.id %>/edit"><i
															class="fa-solid fa-pen"></i></a>
													<form class="d-inline" method="post"
														action="/admin/questions/<%= q.id %>/delete"
														onsubmit="return confirm('Delete this question?')"><input
															type="hidden" name="_csrf" value="<%= csrfToken %>"><button
															class="icon-btn danger"><i
																class="fa-regular fa-trash-can"></i></button></form>
												</td>
											</tr>
											<% }); if(!questions.length){ %>
												<tr>
													<td class="empty" colspan="4">No questions added so far.</td>
												</tr>
												<% } %>
									</tbody>
								</table>
							</div>
						</div>
				</div>
			</main>
	</div>
	<div class="modal fade" id="add">
		<div class="modal-dialog modal-lg">
			<form class="modal-content" method="post" action="/admin/questions">
				<div class="modal-header">
					<h5>Add quiz question</h5><button class="btn-close" data-bs-dismiss="modal"></button>
				</div>
				<div class="modal-body"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label
						class="form-label">Competition</label><select class="form-select mb-3" name="competition_id"
						required>
						<% competitions.forEach(c=>{ %><option value="<%= c.id %>">
								<%= c.title %>
							</option>
							<% }) %>
					</select><label class="form-label">Question</label><textarea class="form-control mb-3"
						name="question_text" required></textarea>
					<div class="row g-2">
						<% ['a','b','c','d'].forEach((x,i)=>{ %><div class="col-md-6"><label class="form-label">Option
									<%= x.toUpperCase() %></label><input class="form-control" name="<%= x %>" required>
							</div>
							<% }) %>
					</div><label class="form-label mt-3">Correct answer</label><select class="form-select"
						name="correct">
						<option value="1">Option A</option>
						<option value="2">Option B</option>
						<option value="3">Option C</option>
						<option value="4">Option D</option>
					</select>
				</div>
				<div class="modal-footer"><button class="btn btn-primary">Save question</button></div>
			</form>
		</div>
	</div>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
	</body>

	</html>